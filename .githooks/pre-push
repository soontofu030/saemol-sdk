#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
node scripts/check-public.mjs
scanner="$(git config --local --get saemol.gitleaksPath || true)"
if [ -z "$scanner" ]; then scanner=gitleaks; fi
if ! command -v "$scanner" >/dev/null 2>&1; then
  echo 'Install Gitleaks or configure git config --local saemol.gitleaksPath /path/to/gitleaks.' >&2
  exit 1
fi
"$scanner" git . --log-opts=--all --redact=100 --no-banner
